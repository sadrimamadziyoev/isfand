# Generate distinct random URL-safe passwords, then copy this file to .env.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
APP_DB_PASSWORD=replace-with-another-random-url-safe-password
MFA_ENCRYPTION_KEY=generate-with-Fernet.generate_key
# ops/configure.py detects and saves your host CA bundle automatically.
# For an existing macOS .env, add BUILD_CA_CERT=/etc/ssl/cert.pem
# For a corporate proxy, set BUILD_CA_CERT to its trusted PEM bundle.
SITE_ADDRESS=localhost
PUBLIC_URL=https://localhost
# Production defaults: secure cookies, verified TLS to SMTP.
COOKIE_SECURE=true
SMTP_ALLOW_INSECURE=false
# Put SMTP credentials in the separate ignored .env.smtp file.
